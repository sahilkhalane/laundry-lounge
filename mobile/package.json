{
  "name": "laundry-lounge-android",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --android",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export --platform android --output-dir build/bundle",
    "prebuild": "expo prebuild --platform android",
    "ios": "expo run:ios",
    "test": "node --import tsx tests/domain.test.ts",
    "apk:release": "expo prebuild --platform android && cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=arm64-v8a --max-workers=3"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.38",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.1.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=24"
  }
}
