{
  "expo": {
    "name": "Laundry Lounge",
    "slug": "laundry-lounge-android",
    "version": "1.0.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "scheme": "laundrylounge",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5faf7"
    },
    "android": {
      "package": "com.laundrylounge.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f5faf7"
      },
      "permissions": ["CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Laundry Lounge to scan garment QR tags.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose the Laundry Lounge business logo.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
